# Frontend V1 runs entirely on isolated in-memory mock data and requires no
# environment variables yet.
#
# Placeholder for the later Django integration phase. Values are examples only —
# never commit real credentials or secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Backend + Database phase — placeholders only, never real values.
POSTGRES_DB=jobboard
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: host UID/GID the backend container runs as, so bind-mounted files
# it creates (migrations, .pytest_cache, .coverage) are host-user-owned, not
# root. Defaults to 1000:1000 if unset. Find yours with `id -u` / `id -g`.
DEV_UID=1000
DEV_GID=1000
