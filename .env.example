# Values here are examples only — never commit real credentials or secrets.
# Copy to .env and fill in real values; .env is git-ignored.

# Read directly by the frontend (dev: npm run dev; prod: baked into the
# frontend image at build time via Dockerfile.frontend's build arg).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Backend + database — used by both docker-compose.yml (dev) and
# docker-compose.prod.yml (production; there, every one of these is required
# and the stack refuses to start if it's unset).
POSTGRES_DB=jobboard
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: host UID/GID the dev backend container runs as, so bind-mounted
# files it creates (migrations, .pytest_cache, .coverage) are host-user-owned,
# not root. Defaults to 1000:1000 if unset. Find yours with `id -u` / `id -g`.
# Dev only -- docker-compose.prod.yml does not use this.
DEV_UID=1000
DEV_GID=1000

# --- Production only (docker-compose.prod.yml); not used in dev ---
#
# DJANGO_ALLOWED_HOSTS above must be the EC2 instance's public IP or domain
# (whatever address the browser uses) once deployed -- e.g.
# DJANGO_ALLOWED_HOSTS=203.0.113.10
#
# CORS_ALLOWED_ORIGINS is normally left empty in production: behind Nginx,
# the browser reaches the frontend and the API on the same origin, so no
# cross-origin request (and therefore no CORS header) is involved.
#
# NEXT_PUBLIC_API_BASE_URL and INTERNAL_API_BASE_URL are set directly in
# docker-compose.prod.yml (a relative /api path baked into the frontend build,
# and http://backend:8000/api for the frontend container's own server-side
# requests) rather than read from this file, since neither ever needs to vary
# by deployment -- see docs/DEPLOYMENT.md.
